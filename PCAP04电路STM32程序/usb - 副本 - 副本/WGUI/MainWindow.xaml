<Window x:Class="USBMatrixDisplay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:USBMatrixDisplay"
        mc:Ignorable="d"
        Title="USB 数据接收 - 矩阵显示" 
        Height="850" Width="1200"
        MinHeight="700" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource MacBackgroundBrush}">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- 顶部控制面板 -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <!-- 左侧：串口控制面板 -->
            <Border Grid.Column="0" Style="{StaticResource MacStylePanel}" Width="750" Height="130" Margin="0,0,15,0">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- 第一行：串口选择和按钮 -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Label Content="串口:" Style="{StaticResource MacStyleLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="PortComboBox" Style="{StaticResource MacStyleComboBox}" Width="300" Margin="0,0,8,0"/>
                        <Button x:Name="ConnectButton" Content="连接" Style="{StaticResource MacStyleButton}" 
                                Background="{StaticResource MacGreenBrush}" Click="ConnectButton_Click"/>
                        <Button x:Name="DisconnectButton" Content="断开" Style="{StaticResource MacStyleButton}" 
                                Background="{StaticResource MacGrayBrush}" IsEnabled="False" Click="DisconnectButton_Click" Margin="8,0,8,0"/>
                        <Button x:Name="RefreshButton" Content="刷新" Style="{StaticResource MacStyleButton}" 
                                Background="{StaticResource MacGrayBrush}" Click="RefreshButton_Click"/>
                    </StackPanel>
                    
                    <!-- 第二行：状态和自动连接 -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal">
                        <Label x:Name="StatusLabel" Content="状态: 未连接" Style="{StaticResource MacStyleLabel}" 
                               Foreground="{StaticResource MacSecondaryTextBrush}"/>
                        <CheckBox x:Name="AutoReconnectCheckBox" Content="自动连接" Margin="15,0,0,0" 
                                  VerticalAlignment="Center" FontFamily="Segoe UI" FontSize="13"
                                  Checked="AutoReconnectCheckBox_Checked" Unchecked="AutoReconnectCheckBox_Unchecked"/>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- 右侧：显示模式面板 -->
            <Border Grid.Column="1" Style="{StaticResource MacStylePanel}" Width="370" Height="130">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- 第一行：显示模式 -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                        <Label Content="显示模式:" Style="{StaticResource MacStyleLabel}" Margin="0,0,8,0"/>
                        <RadioButton x:Name="HexModeRadio" Content="十六进制" GroupName="DisplayMode" 
                                     FontFamily="Segoe UI" FontSize="13" Margin="0,0,8,0"
                                     Checked="HexModeRadio_Checked"/>
                        <RadioButton x:Name="StringModeRadio" Content="字符串" GroupName="DisplayMode" 
                                     FontFamily="Segoe UI" FontSize="13" IsChecked="True"
                                     Checked="StringModeRadio_Checked"/>
                    </StackPanel>
                    
                    <!-- 第二行：接收数据统计 -->
                    <Label Grid.Row="1" x:Name="ReceivedDataLabel" Content="接收字节数: 0" Style="{StaticResource MacStyleLabel}" Margin="0,5,0,0"/>
                </Grid>
            </Border>
        </Grid>
        
        <!-- 底部：矩阵和数据区域 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" x:Name="LeftColumn"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="1*" x:Name="RightColumn"/>
            </Grid.ColumnDefinitions>
            
            <!-- 左侧：矩阵显示 -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <Label Grid.Row="0" Content="16x16 数据矩阵" FontFamily="Segoe UI" FontSize="14" FontWeight="Bold" 
                       Foreground="{StaticResource MacTextBrush}" Margin="0,0,0,8"/>
                
                <Border Grid.Row="1" Style="{StaticResource MacStylePanel}" Padding="12">
                    <local:MatrixDisplayControl x:Name="MatrixPanel"/>
                </Border>
            </Grid>
            
            <!-- 分隔条 -->
            <Border Grid.Column="1" Background="{StaticResource MacBorderBrush}" 
                    MouseDown="Splitter_MouseDown" MouseMove="Splitter_MouseMove" MouseUp="Splitter_MouseUp"
                    Cursor="SizeWE"/>
            
            <!-- 右侧：原始数据显示 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <Label Grid.Row="0" Content="接收的原始数据" FontFamily="Segoe UI" FontSize="14" FontWeight="Bold" 
                       Foreground="{StaticResource MacTextBrush}" Margin="0,0,0,8"/>
                
                <Border Grid.Row="1" Style="{StaticResource MacStylePanel}" Padding="12">
                    <Grid>
                        <TextBox x:Name="DataTextBox" Style="{StaticResource MacStyleTextBox}" 
                                 TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                        <Button x:Name="ClearButton" Content="清空显示" Style="{StaticResource MacStyleButton}" 
                                Background="{StaticResource MacGrayBrush}" 
                                HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10"
                                Click="ClearButton_Click"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>

